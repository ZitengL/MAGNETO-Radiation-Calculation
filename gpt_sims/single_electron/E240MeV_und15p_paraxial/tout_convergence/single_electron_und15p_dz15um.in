# Single electron through the 15-period (K ~ 1) undulator, 240 MeV, near-axis paraxial map
# Reference for the multi-electron run gpt_sims/multi_electron/E240MeV_und15p_N2000
# (same field, same output grid). Undulator centre at z = 1.0 m, main component By -> horizontal wiggle.

# ---------------- Beam ----------------
E0   = 240e6 ;                        # kinetic energy [eV]
G    = 1 + E0*abs(qe)/(me*c*c) ;      # Lorentz factor (kinetic energy -> gamma)
GB   = sqrt(G*G - 1) ;                # gamma*beta

# One electron at the origin, moving along +z with no transverse momentum
setstartpar("beam", 0,0,0, 0,0,GB, me,qe,1) ;

# ---------------- Undulator field map ----------------
zund = 1.0 ;                          # undulator centre [m]
zmap = 0.32004 ;                      # half length of the field map [m]
# ECS: origin (0,0,zund); new x-axis = WCS +y, new y-axis = WCS -x
# => map Bx (main component) becomes WCS By
map3D_B("wcs", 0,0,zund, 0,1,0, -1,0,0, "../../../../field_map/und15p_K1_paraxial.gdf", "x","y","z","Bx","By","Bz", 1) ;

# ---------------- Accuracy ----------------
accuracy(6) ;

# ---------------- Output ----------------
# Same output grid as the multi-electron run: one output every c*dt = 60 um from z ~ 0.65 m,
# stop 5 cm after the end of the field map.
zstop  = zund + zmap + 0.05 ;
dz     = 15e-6 ;   # tout convergence run (main run: 60e-6)
tstart = floor(0.65/dz)*dz/c ;
tout(tstart, zstop/c, dz/c) ;
