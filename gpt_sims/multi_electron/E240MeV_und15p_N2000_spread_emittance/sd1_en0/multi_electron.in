# 2000 electrons through the 15-period (K ~ 1) undulator, 240 MeV, no space charge,
# with initial energy spread and emittance (case: sig_d = 0.01, en = 0 m rad).
# Undulator centre at z = 1.0 m, field map rotated 90 deg about z so that the
# main on-axis component is By  ->  horizontal (x) wiggle (same as E240MeV_und15p_N2000).

# ---------------- Beam ----------------
# Initial distribution from ../make_distributions.m (waist at z = 1 m with sigma_x = sigma_y = 20 um,
# sigma_z = 10 nm, energy spread sig_d, normalised emittance en in x and y; each macro-particle = 1 electron).
setfile("beam", "initial_distribution.gdf") ;

# ---------------- Undulator field map ----------------
zund = 1.0 ;                          # undulator centre [m]
zmap = 0.32004 ;                      # half length of the field map [m]
# ECS: origin (0,0,zund); new x-axis = WCS +y, new y-axis = WCS -x => map Bx (main component) becomes WCS By
# Map |x|,|y| <= 2 mm, 50 um step, exact Laplace continuation (field_map/make_laplace_map_2mm.m);
# identical to und15p_K1_paraxial.gdf within 0.25 mm of the axis.
map3D_B("wcs", 0,0,zund, 0,1,0, -1,0,0, "../../../../field_map/und15p_K1_laplace_2mm.gdf", "x","y","z","Bx","By","Bz", 1) ;

# ---------------- Accuracy ----------------
accuracy(6) ;

# ---------------- Output ----------------
# Same as E240MeV_und15p_N2000: one output every c*dt = 60 um from z ~ 0.65 m to 5 cm after the field map.
zstop  = zund + zmap + 0.05 ;
dz     = 60e-6 ;
tstart = floor(0.65/dz)*dz/c ;
tout(tstart, zstop/c, dz/c) ;