# 2000 electrons through the 15-period (K ~ 1) undulator field map, 240 MeV, no space charge
# Undulator centre at z = 1.0 m, field map rotated 90 deg about z so that the
# main on-axis component is By  ->  horizontal (x) wiggle (same as E7GeV_und15p_K1).

# ---------------- Beam ----------------
# Initial distribution from make_distribution.m (Gaussian, sigma_x = sigma_y = 20 um,
# sigma_z = 10 nm, cut at 4 sigma, pseudo-random seed 20261022, 240 MeV kinetic,
# no energy spread or divergence, each macro-particle = 1 electron). All start at t = 0.
setfile("beam", "initial_distribution.gdf") ;

# ---------------- Undulator field map ----------------
zund = 1.0 ;                          # undulator centre [m]
zmap = 0.32004 ;                      # half length of the field map [m]
# ECS: origin (0,0,zund); new x-axis = WCS +y, new y-axis = WCS -x
# => map Bx (main component) becomes WCS By
# Near-axis map (|x|,|y| <= 0.25 mm, 25 um step) from the second-order paraxial expansion of
# und15p_K1_field_map.gdf (field_map/make_paraxial_map.m). The coarse transverse grid of the
# original map (2.868 mm) made GPT's linear interpolation raise the field ~|offset| near the axis.
map3D_B("wcs", 0,0,zund, 0,1,0, -1,0,0, "../../../field_map/und15p_K1_paraxial.gdf", "x","y","z","Bx","By","Bz", 1) ;

# ---------------- Accuracy ----------------
accuracy(6) ;

# ---------------- Output ----------------
# Stop 5 cm after the end of the field map; one output every c*dt = 60 um.
# Output only from z ~ 0.65 m (3 cm before the field map starts at 0.67996 m): the
# drift before carries no field, contributes nothing to the radiation and would
# double the file size. tstart is on the same 60 um grid as a run that outputs from t = 0.
zstop  = zund + zmap + 0.05 ;
dz     = 60e-6 ;
tstart = floor(0.65/dz)*dz/c ;
tout(tstart, zstop/c, dz/c) ;
