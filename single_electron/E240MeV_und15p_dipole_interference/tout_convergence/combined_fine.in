# Single electron, 240 MeV: real 15-period undulator (centre z = 1 m) followed by the short dipole
# (0.1 m, 0.65 T, bend up) at distance D downstream. Interference of undulator and dipole radiation.
# Run with D on the command line, e.g.  gpt -o result.gdf combined.in D=0.5 GPTLICENSE=...

# ---------------- Beam ----------------
E0   = 240e6 ;                        # kinetic energy [eV]
G    = 1 + E0*abs(qe)/(me*c*c) ;      # Lorentz factor (kinetic energy -> gamma)
GB   = sqrt(G*G - 1) ;                # gamma*beta

# One electron at the origin, moving along +z with no transverse momentum
setstartpar("beam", 0,0,0, 0,0,GB, me,qe,1) ;

# ---------------- Geometry ----------------
# D (command line, [m]) = distance from the end of the undulator field map (z = 1.32004 m)
# to the effective entrance of the dipole (dipole centre - Ldip/2).
zund = 1.0 ;                          # undulator centre [m]
zmap = 0.32004 ;                      # half length of the field map [m]
Ldip = 0.1 ;                          # dipole effective length [m]
zcen = zund + zmap + D + Ldip/2 ;     # dipole centre [m]
# ---------------- Undulator (real Radia map, paraxial version) ----------------
# ECS: origin (0,0,zund); new x-axis = WCS +y, new y-axis = WCS -x => map Bx (main) becomes WCS By
map3D_B("wcs", 0,0,zund, 0,1,0, -1,0,0, "../../../../field_map/und15p_K1_paraxial.gdf", "x","y","z","Bx","By","Bz", 1) ;
# ---------------- Dipole (same as gpt_sims/single_electron/E240MeV_dipole_L10cm) ----------------
# 0.65 T along WCS -x (electron bent up, +y), Enge fringe with gap 1 cm (b1 = 200 1/m), field 0 beyond 10/b1 = 5 cm
Bdip = 0.65 ; gap = 0.01 ; b1 = 2/gap ; adip = 0.2 ;
rectmagnet("wcs", 0,0,zcen, 0,1,0, -1,0,0, adip, Ldip, Bdip, 0, b1, 0) ;
# ---------------- Accuracy ----------------
accuracy(6) ;

# ---------------- Output ----------------
# Two output grids: every 60 um/c through the undulator (converged there) up to 12 cm before the
# dipole centre (in the field-free drift), then every 3.75 um/c through the dipole (needed there)
# until 5 cm after its field ends (zcen + 0.15 m).
dz1 = 30e-6 ;  dz2 = 1.875e-6 ;   # convergence copy: only the two output steps halved
t1a = floor(0.65/dz1)*dz1/c ;          t1b = (zcen - 0.12)/c ;
t2a = floor((zcen - 0.115)/dz2)*dz2/c ; t2b = (zcen + 0.15)/c ;
tout(t1a, t1b, dz1/c) ;
tout(t2a, t2b, dz2/c) ;